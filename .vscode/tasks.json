{
    "version": "2.0.0",
    "tasks": [
        // =================================================================
        // 1. CMake Configure (Debug) — 只在第一次或 CMakeLists.txt 变了时手动跑
        // =================================================================
        {
            "label": "CMake: configure (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-G", "MinGW Makefiles",
                "-S", "${workspaceFolder}",
                "-B", "${workspaceFolder}/build-mingw",
                "-DCMAKE_CXX_COMPILER=g++",
                "-DCMAKE_MAKE_PROGRAM=mingw32-make",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "options": {
                "env": {
                    "PATH": "E:/Workdaddy/mingw64/bin;E:/Workdaddy/mingw32/mingw32/bin;${env:PATH}"
                }
            },
            "problemMatcher": [],
            "group": "build"
        },

        // =================================================================
        // 2. Build (Debug) — 不依赖 configure，增量编译
        //    （configure 已经在 build-mingw/ 里生成过一次 Makefile 就行）
        // =================================================================
        {
            "label": "CMake: build (Debug)",
            "type": "shell",
            "command": "mingw32-make",
            "args": ["-C", "${workspaceFolder}/build-mingw", "-j4"],
            "options": {
                "env": {
                    "PATH": "E:/Workdaddy/mingw64/bin;E:/Workdaddy/mingw32/mingw32/bin;${env:PATH}"
                }
            },
            "problemMatcher": ["$gcc", "$mingw"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },

        // =================================================================
        // 2b. 单文件语法检查（-fsyntax-only，不链接、不产出 obj）
        //     用途：只想快速看某个文件有没有编译错误时用，比整包 build 快得多。
        //     为什么需要它：VS Code 右键菜单的「单独编译」是裸 g++，不带 -I，
        //     会报 newrpa/cdp/CDPDomains.h: No such file or directory。
        //     本项目的 include 路径由 CMake 注入（见 build-mingw 下的 includes_CXX.rsp），
        //     这里取各目标路径的并集，所以任何源文件都能查。
        //     用法：打开目标 .cpp → Ctrl+Shift+P → Tasks: Run Task →
        //           「C++: 语法检查当前文件」，或直接绑快捷键。
        // =================================================================
        {
            "label": "C++: 语法检查当前文件",
            "type": "shell",
            "command": "E:/Workdaddy/mingw64/bin/g++.exe",
            "args": [
                "-fsyntax-only",
                "-std=c++20",
                "-pthread",
                "-DNEWRPA_USE_DLL",
                "-DSPDLOG_COMPILED_LIB",
                "-DNOMINMAX",
                "-I${workspaceFolder}/core/include",
                "-I${workspaceFolder}/core/src/keyBoard",
                "-I${workspaceFolder}/core/include/newrpa/singleUsbbox",
                "-I${workspaceFolder}/core/src/des",
                "-I${workspaceFolder}/third_party/nlohmann_json/include",
                "-I${workspaceFolder}/third_party/spdlog/include",
                "-isystem", "${workspaceFolder}/third_party/cpp_httplib",
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "E:/Workdaddy/mingw64/bin;E:/Workdaddy/mingw32/mingw32/bin;${env:PATH}"
                }
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },

        // =================================================================
        // 3. 插件 DLL 自动复制到 bin/plugins — build 完自动跑
        //    只拷银行插件（排除 NewRpaCore.dll，它不是插件，加载会报错）
        // =================================================================
        {
            "label": "Copy DLLs to plugins/",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile", "-Command",
                "$dst='${workspaceFolder}/build-mingw/bin/plugins'; New-Item -ItemType Directory -Force -Path $dst | Out-Null; Get-ChildItem '${workspaceFolder}/build-mingw/bin/*.dll' | Where-Object { $_.Name -notlike '*NewRpaCore*' } | ForEach-Object { $df=Join-Path $dst $_.Name; if (-not (Test-Path $df)) { Copy-Item $_.FullName $df -Force; Write-Host \"Fill missing: $($_.Name) -> plugins/\" } else { Write-Host \"Skip $($_.Name): CMake already outputs to plugins/ - never overwrite a newer build\" } }"
            ],
            "problemMatcher": []
        },

        // =================================================================
        // 3b. 杀掉上次调试残留的 newrpa.exe
        //     （不杀的话链接器写 newrpa.exe 会 Permission denied，
        //       F5 编译直接失败，这是最常见的"F5 不重新编译"原因）
        // =================================================================
        {
            "label": "Kill stale newrpa",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile", "-Command",
                "$p = Get-Process newrpa -ErrorAction SilentlyContinue; if ($p) { $p | Stop-Process -Force; Start-Sleep -Milliseconds 500; Write-Host ('Killed stale newrpa.exe pid=' + ($p.Id -join ',')) } else { Write-Host 'No stale newrpa.exe' }"
            ],
            "problemMatcher": []
        },

        // =================================================================
        // 4. preLaunchTask 组合：杀残留 → build → copy dlls
        // =================================================================
        {
            "label": "Build + Copy DLLs",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Kill stale newrpa",
                "CMake: build (Debug)",
                "Copy DLLs to plugins/"
            ],
            "problemMatcher": []
        },

        // =================================================================
        // 4b. Ensure Chrome CDP 9222 — 北京银行查询版 F5 专用前置
        //     查询版必须走真实浏览器 + 有缓存的 profile（boj_hw_profile2），
        //     否则顶象风控更容易直接降级成「请使用图形验证码」。
        //     已就绪则秒过；未就绪则自动拉起 chrome-portable。
        // =================================================================
        {
            "label": "Ensure Chrome CDP 9222",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile", "-Command",
                "$ErrorActionPreference='Stop'; $port=9222; $ready=$false; try { $r=Invoke-RestMethod -Uri \"http://127.0.0.1:$port/json/version\" -TimeoutSec 3; $ready=$true; Write-Host ('CDP READY: ' + $r.Browser) } catch { }; if (-not $ready) { $chrome='C:\\Program Files\\chrome-portable\\chrome-win64\\chrome.exe'; if (-not (Test-Path $chrome)) { $chrome='C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe' }; if (-not (Test-Path $chrome)) { Write-Host 'ERROR: 找不到 chrome.exe'; exit 1 }; $ud='E:/NewRpa-Next/build-mingw/bin/boj_hw_profile2'; Write-Host ('CDP not ready, launching: ' + $chrome); Start-Process -FilePath $chrome -ArgumentList @('--remote-debugging-port=9222', ('--user-data-dir=' + $ud), '--no-first-run', '--no-default-browser-check', 'https://cbank.bankofbeijing.com.cn/login?redirect=%2F&version=query') -WindowStyle Normal; $ok=$false; for ($i=0; $i -lt 15; $i++) { Start-Sleep -Seconds 1; try { $r=Invoke-RestMethod -Uri \"http://127.0.0.1:$port/json/version\" -TimeoutSec 2; $ok=$true; break } catch { } }; if (-not $ok) { Write-Host 'ERROR: CDP 9222 启动超时'; exit 1 }; Write-Host ('CDP STARTED: ' + $r.Browser) }"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },

        // =================================================================
        // 4c. F5 前置链（北京银行查询版）：确保 Chrome → 杀残留 → build → 拷 DLL
        // =================================================================
        {
            "label": "Debug BCB Query (prepare)",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Kill stale newrpa",
                "CMake: build (Debug)",
                "Copy DLLs to plugins/"
            ],
            "problemMatcher": []
        },

        // =================================================================
        // 5. 启动 Chrome（Debug 调试前手动启，不跟随 VSCode 退出）
        //    使用独立的 user-data-dir 避免污染日常 Chrome profile
        // =================================================================
        {
            "label": "Launch Chrome (CDP 9222)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile", "-Command",
                "$chrome='C:\\Program Files\\chrome-portable\\chrome-win64\\chrome.exe'; if (!(Test-Path $chrome)) { $chrome='C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe' }; $existing = Get-NetTCPConnection -LocalPort 9222 -ErrorAction SilentlyContinue; if ($existing) { Write-Host 'CDP 9222 already in use (pid=' + $existing.OwningProcess + ')' } else { Stop-Process chrome -ErrorAction SilentlyContinue; Start-Sleep 1; Start-Process -FilePath $chrome -ArgumentList @('--remote-debugging-port=9222','--no-first-run','--ignore-certificate-errors','--disable-gpu','--disable-software-rasterizer','--disable-background-timer-throttling','--disable-backgrounding-occluded-windows','--disable-renderer-backgrounding','--user-data-dir=C:\\temp\\chrome-rpa-profile','about:blank') -WindowStyle Normal; Start-Sleep 4; try { $r = Invoke-RestMethod -Uri 'http://127.0.0.1:9222/json/version' -TimeoutSec 5; Write-Host ('CDP READY - Browser: ' + $r.Browser) } catch { Write-Host 'CDP FAILED - check Chrome exe path' } }"
            ],
            "problemMatcher": []
        },

        // =================================================================
        // 6. Clean rebuild — 清空 build-mingw 重 configure
        // =================================================================
        {
            "label": "Clean rebuild (Debug)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile", "-Command",
                "Remove-Item '${workspaceFolder}/build-mingw' -Recurse -Force -ErrorAction SilentlyContinue; Write-Host 'Cleaned'"
            ],
            "problemMatcher": []
        }
    ]
}
