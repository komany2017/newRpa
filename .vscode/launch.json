        // 启动 Chrome (独立进程, 稳定化参数)
        {
            "name": "启动 Chrome (CDP 9222)",
            "type": "cppdbg", "request": "launch",
            "program": "C:/Program Files/chrome-portable/chrome-win64/chrome.exe",
            "args": [
                "--remote-debugging-port=9222", "--no-first-run",
                "--ignore-certificate-errors", "--disable-gpu",
                "--disable-software-rasterizer",
                "--disable-background-timer-throttling",
                "--disable-backgrounding-occluded-windows",
                "--disable-renderer-backgrounding",
                "--user-data-dir=C:/temp/chrome-rpa-profile",
                "about:blank"
            ],
            "stopAtEntry": false, "externalConsole": false,
            "MIMode": "gdb", "miDebuggerPath": "E:/Workdaddy/mingw64/bin/gdb.exe"
