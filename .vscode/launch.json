        // 列出所有加载的插件 (不用 Chrome)
        {
            "name": "列出已加载插件 (newrpa list)",
            "type": "cppdbg", "request": "launch",
            "program": "${workspaceFolder}/build-mingw/bin/newrpa.exe",
            "args": [ "list", "--config", "${workspaceFolder}/build-mingw/bin/config.json" ],
            "cwd": "${workspaceFolder}/build-mingw/bin",
